def run_basic_chatbot():
    print("--- CodeAlpha Basic Chatbot ---")
    print("Chatbot: Hello! Type 'bye' or 'exit' to end the chat.")

    while True:
        user_input = input("\nYou: ").lower().strip()

        if user_input in ["hi", "hello", "hey"]:
            print("Chatbot: Hi! It's nice to meet you.")
        elif user_input in ["how are you", "how are you?"]:
            print("Chatbot: I'm fine, thanks!")
        elif user_input in ["what is your name", "who are you"]:
            print("Chatbot: I am a basic rule-based chatbot for Python internship.")
        elif user_input in ["bye", "exit", "quit"]:
            print("Chatbot: Goodbye! Have a great day!")
            break
        else:
            print("Chatbot: I'm sorry, I don't understand that.")

if __name__ == "__main__":
    run_basic_chatbot()
